rules_version = '2';

// Hifz Tracker access rules.
//
//   owners      listed below (keep in sync with firebase/owners.json; the rules test checks it): everything.
//   members     one doc per teacher email in members/<email>, kept in sync with the app's Teachers list by
//               owners/admins (firebase/src/boot.js, startMemberSync). Role: admin | teacher | supervisor.
//     admin       read and write everything, manage teachers and members.
//     teacher     read everything; record in any group of the schools they work in (teachers/<tid>.schools,
//                 kept to include the schools of their own groups by the admins' app), in their own groups
//                 (classes.teacher) and in groups they have substitute access to (access/<cid>_<tid>): sessions,
//                 attendance, mushaf marks, class log, a student's position and practice fields. In their own and
//                 substitute groups also a student's surahs (Edit details). Start a new
//                 group of their own and add new students to their own groups. Substitute notes, substitute
//                 access and absences only as the main teacher. Nothing that changes the school's setup.
//     supervisor  read only.
//   feedback    anyone above may send a suggestion or problem; only admins read them.
//   anyone else nothing.
//
// Only verified emails count: Google and email-link sign-in are verified, so nobody can claim a teacher's
// address by creating a password account with it.

service cloud.firestore {
  match /databases/{database}/documents {

    function owners() {
      return ['edin.livnjak2@gmail.com', 'elssenosy@gmail.com'];
    }
    function signedInVerified() {
      return request.auth != null
        && request.auth.token.get('email', '') != ''
        && request.auth.token.get('email_verified', false) == true;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function isOwner() {
      return signedInVerified() && myEmail() in owners();
    }
    function memberPath() {
      return /databases/$(database)/documents/members/$(myEmail());
    }
    function member() {
      return get(memberPath()).data;
    }
    function isMember() {
      return signedInVerified() && exists(memberPath()) && member().get('active', true) != false;
    }
    function memberRole() {
      return member().get('role', 'teacher');
    }
    function isAdmin() {
      return isOwner() || (isMember() && memberRole() == 'admin');
    }
    function isTeacher() {
      return !isOwner() && isMember() && memberRole() == 'teacher';
    }
    function canRead() {
      return isOwner() || isMember();
    }
    function myTid() {
      return member().get('tid', '');
    }

    // Record data must not carry an `id` field that differs from the document id, and document ids may not
    // contain characters that matter in HTML: the app shows ids inside its pages.
    function safeId(id) {
      return id.matches('^[^"\'<>&`\\s]{1,200}$');
    }
    function safeData(id) {
      return request.resource.data.get('id', id) == id;
    }

    // ---- teacher scope ----
    function pad2(n) {
      return n < 10 ? '0' + string(n) : string(n);
    }
    function dayOf(t) {
      return string(t.year()) + '-' + pad2(t.month()) + '-' + pad2(t.day());
    }
    // Substitute access dates are the school's local dates; UTC can be a day off, so allow one day either side.
    function accessActive(a) {
      return a.get('kind', '') == 'always'
        || (a.get('from', '') <= dayOf(request.time + duration.value(1, 'd'))
            && (a.get('until', '') != '' ? a.until : a.get('from', '')) >= dayOf(request.time - duration.value(1, 'd')));
    }
    function classDoc(cid) {
      return get(/databases/$(database)/documents/classes/$(cid));
    }
    function isMainTeacher(cid) {
      return cid is string && cid != '' && myTid() != ''
        && exists(/databases/$(database)/documents/classes/$(cid))
        && classDoc(cid).data.get('teacher', '') == myTid();
    }
    function hasSubAccess(cid) {
      let path = /databases/$(database)/documents/access/$(cid + '_' + myTid());
      return exists(path) && get(path).data.get('cid', '') == cid && get(path).data.get('tid', '') == myTid()
        && accessActive(get(path).data);
    }
    function canTeachClass(cid) {
      return cid is string && cid != '' && (isMainTeacher(cid) || hasSubAccess(cid));
    }
    // Recording: own groups, substitute access, or any group of a school the teacher works in (covering a class).
    function inMySchool(cid) {
      let tpath = /databases/$(database)/documents/teachers/$(myTid());
      return cid is string && cid != '' && myTid() != ''
        && exists(/databases/$(database)/documents/classes/$(cid))
        && classDoc(cid).data.get('school', '') != ''
        && exists(tpath)
        && get(tpath).data.get('active', true) != false
        && classDoc(cid).data.get('school', '') in get(tpath).data.get('schools', []);
    }
    function canRecordClass(cid) {
      return canTeachClass(cid) || inMySchool(cid);
    }
    function canRecordStudent(sid) {
      return sid is string && sid != ''
        && exists(/databases/$(database)/documents/students/$(sid))
        && canRecordClass(get(/databases/$(database)/documents/students/$(sid)).data.get('cls', ''));
    }
    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // Access list. People may read their own entry (the app checks it at sign-in); admins manage all of it.
    match /members/{email} {
      allow get: if signedInVerified() && email == myEmail();
      allow read, write: if isAdmin();
    }

    // Collections the app uses. Admins write everything; teachers write within their groups, as below.
    match /{coll}/{id} {
      allow read: if coll in ['students', 'events', 'classes', 'meetings', 'breaks', 'marks', 'settings', 'schedule',
                              'fees', 'teachers', 'access', 'absences', 'groupnotes', 'requests', 'waiting', 'links',
                              'schools', 'hours', 'simpairs']
        && canRead();
      allow delete: if coll != 'members' && isAdmin();
      allow create, update: if coll in ['students', 'events', 'classes', 'meetings', 'breaks', 'marks', 'settings',
                                        'schedule', 'fees', 'teachers', 'access', 'absences', 'groupnotes', 'requests',
                                        'waiting', 'links', 'schools', 'hours', 'simpairs']
        && safeId(id) && safeData(id) && isAdmin();
    }

    // Sessions, attendance, tests, notes and points: the teacher must be able to record for the student (canRecordStudent).
    match /events/{id} {
      // attendance ids are a_<sid>_<date>: nobody may take another student's id
      allow create: if isTeacher() && safeId(id) && safeData(id) && canRecordStudent(request.resource.data.get('sid', ''))
        && (!id.matches('^a_.*') || id == 'a_' + request.resource.data.sid + '_' + request.resource.data.get('date', ''));
      allow update: if isTeacher() && safeData(id) && canRecordStudent(resource.data.get('sid', ''))
        && canRecordStudent(request.resource.data.get('sid', ''));
      allow delete: if isTeacher() && canRecordStudent(resource.data.get('sid', ''));
    }
    // Similar verses a teacher adds for the whole school: two lists of ayah numbers, a short note, who and when.
    match /simpairs/{id} {
      allow create: if isTeacher() && safeId(id) && safeData(id)
        && request.resource.data.keys().hasOnly(['o', 'm', 'note', 'by', 'at'])
        && request.resource.data.o is list && request.resource.data.o.size() > 0 && request.resource.data.o.size() <= 5
        && request.resource.data.m is list && request.resource.data.m.size() > 0 && request.resource.data.m.size() <= 5
        && request.resource.data.get('note', '') is string && request.resource.data.get('note', '').size() <= 200;
    }
    // Mushaf mistake marks: same as events.
    match /marks/{id} {
      allow create: if isTeacher() && safeId(id) && safeData(id) && canRecordStudent(request.resource.data.get('sid', ''));
      allow update: if isTeacher() && safeData(id) && canRecordStudent(resource.data.get('sid', ''))
        && canRecordStudent(request.resource.data.get('sid', ''));
      allow delete: if isTeacher() && canRecordStudent(resource.data.get('sid', ''));
    }
    // A student's position, fixed mistakes, review focus and tajweed practice, and the student's surahs (where new
    // hifz starts and its order, surahs memorized before, position log); never name, group or other details.
    // A teacher may also add a new student, only into a group they are the main teacher of, with only the fields of
    // the Add student form (no archive flag, no log); after that only admins change the details, group or delete.
    match /students/{id} {
      allow update: if isTeacher() && canRecordClass(resource.data.get('cls', ''))
        && changedOnly(['pos', 'fixed', 'focus', 'tjp']);
      allow update: if isTeacher() && canTeachClass(resource.data.get('cls', ''))
        && changedOnly(['pos', 'fixed', 'focus', 'tjp', 'order', 'startS', 'prevS', 'prev', 'posLog'])
        && request.resource.data.get('prevS', []) is list && request.resource.data.get('prev', []) is list
        && request.resource.data.get('posLog', []) is list && request.resource.data.get('order', '') is string;
      allow create: if isTeacher() && safeId(id) && safeData(id)
        && isMainTeacher(request.resource.data.get('cls', ''))
        && request.resource.data.keys().hasOnly(['name', 'cls', 'order', 'startS', 'prevS', 'prev', 'amount', 'farDays',
                                                 'readPages', 'readStart', 'readFrom', 'start', 'phone', 'days', 'pos',
                                                 'created'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 200;
    }
    // Class log (id <cid>_<date>).
    match /meetings/{id} {
      allow create: if isTeacher() && safeId(id) && safeData(id) && canRecordClass(request.resource.data.get('cls', ''))
        && id == request.resource.data.cls + '_' + request.resource.data.get('date', '');
      allow update: if isTeacher() && safeData(id) && canRecordClass(resource.data.get('cls', ''))
        && request.resource.data.get('cls', '') == resource.data.get('cls', '');
    }
    // Tajweed topics covered, saved with the class log.
    // A teacher may also start a new group of their own (they are its teacher), with only the fields of the new
    // group form; renaming, other changes and deleting stay with admins.
    match /classes/{id} {
      allow update: if isTeacher() && canRecordClass(id) && changedOnly(['tajweed']);
      allow create: if isTeacher() && safeId(id) && safeData(id) && myTid() != ''
        && request.resource.data.get('teacher', '') == myTid()
        && request.resource.data.keys().hasOnly(['name', 'teacher', 'time', 'end', 'days', 'school', 'n'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100;
    }
    // The main teacher of a group: notes for substitutes, substitute access, absences.
    match /groupnotes/{cid} {
      allow create, update: if isTeacher() && safeId(cid) && safeData(cid) && isMainTeacher(cid);
    }
    match /access/{id} {
      allow create, update: if isTeacher() && safeId(id) && safeData(id) && isMainTeacher(request.resource.data.get('cid', ''))
        && id == request.resource.data.cid + '_' + request.resource.data.get('tid', '');
      allow delete: if isTeacher() && isMainTeacher(resource.data.get('cid', ''));
    }
    match /absences/{id} {
      allow create: if isTeacher() && safeId(id) && safeData(id) && isMainTeacher(request.resource.data.get('cid', ''))
        && request.resource.data.get('tid', '') == myTid();
      allow delete: if isTeacher() && (isMainTeacher(resource.data.get('cid', '')) || resource.data.get('tid', '') == myTid());
    }
    // Asking an admin to move a student to another group.
    match /requests/{id} {
      allow create: if isTeacher() && safeId(id) && safeData(id) && canRecordStudent(request.resource.data.get('sid', ''))
        && request.resource.data.get('status', '') == 'open';
    }
    // A teacher's own hours (id <tid>_<date>) and own sign-in link.
    match /hours/{id} {
      allow create, update: if isTeacher() && safeId(id) && safeData(id) && myTid() != ''
        && request.resource.data.get('tid', '') == myTid() && id == myTid() + '_' + request.resource.data.get('date', '');
    }
    match /links/{uid} {
      allow create, update: if isTeacher() && uid == request.auth.uid && safeData(uid) && myTid() != ''
        && request.resource.data.get('tid', '') == myTid();
    }

    // Suggestions and problems (feedback.js). Everyone signed in (supervisors too) may send one in their own name,
    // or without a name (anon: true, name and email left empty, so nobody can tell who sent it); only
    // admins read, mark and delete them. An email copy ({to, message}, sent by the Trigger Email extension) may only go to
    // the address the admins chose in settings/main.feedbackEmail, so nobody can use it to email anyone else.
    function feedbackEmail() {
      let s = /databases/$(database)/documents/settings/main;
      return exists(s) ? get(s).data.get('feedbackEmail', '') : '';
    }
    match /feedback/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if canRead() && safeId(id)
        && request.resource.data.keys().hasOnly(['kind', 'text', 'by', 'email', 'anon', 'page', 'at', 'date', 'status', 'to', 'message'])
        && ((request.resource.data.get('anon', false) == false && request.resource.data.email == myEmail())
          || (request.resource.data.get('anon', false) == true && request.resource.data.email == '' && request.resource.data.by == ''))
        && request.resource.data.status == 'new'
        && request.resource.data.kind in ['idea', 'problem']
        && request.resource.data.text is string && request.resource.data.text.size() <= 3000
        && (!('to' in request.resource.data) || (request.resource.data.to != '' && request.resource.data.to == feedbackEmail()))
        && (!('message' in request.resource.data) || 'to' in request.resource.data);
    }
  }
}
