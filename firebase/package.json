{
  "name": "hifz-tracker-firebase",
  "private": true,
  "description": "Firebase layer for Hifz Tracker: replaces the Claude Artifact runtime (db, user, downloads) and adds sign-in.",
  "scripts": {
    "bundle": "esbuild src/boot.js --bundle --minify --format=iife --target=es2020 --outfile=../public/fb.js",
    "test:rules": "firebase emulators:exec --only firestore --project demo-hifz \"node --test test/rules.test.mjs\"",
    "test:e2e": "firebase emulators:exec --only auth,firestore,hosting --project demo-hifz \"node test/e2e.mjs\""
  },
  "dependencies": {
    "firebase": "13.1.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "esbuild": "0.28.2",
    "playwright": "1.64.1"
  }
}
